# AutoIDOR configuration template
# Copy this file to .env and replace every placeholder marked <CHANGE_ME>.
# Never commit .env or real credentials. Browser state files contain
# authentication cookies/tokens and are ignored by Git.

# ---------------------------------------------------------------------------
# Target scope
# ---------------------------------------------------------------------------

# Required. Host or origin that the crawler, proxy, selector, and replayer
# are authorized to access. Include the scheme for URL-driven runs.
SCOPE_DOMAIN=http://example.test

# Optional label stored with selected candidates.
OWNER_SESSION_LABEL=owner

# ---------------------------------------------------------------------------
# Login and identity configuration
# ---------------------------------------------------------------------------

# Login page. Relative paths such as /login are resolved against the target
# origin supplied to AutoIDOR.py.
LOGIN_URL=/login

# Legacy single-account settings. These are retained for compatibility.
# Prefer the identity-specific settings below for IDOR testing.
LOGIN_USERNAME=<CHANGE_ME>
LOGIN_PASSWORD=<CHANGE_ME>

# Victim/owner account: owns the original object being tested.
VICTIM_USERNAME=<CHANGE_ME>
VICTIM_PASSWORD=<CHANGE_ME>

# Attacker/second account: attempts to access the victim's object.
ATTACKER_USERNAME=<CHANGE_ME>
ATTACKER_PASSWORD=<CHANGE_ME>

# Leave these empty for URL-driven AutoIDOR.py runs. The runner derives:
# captures/<scheme>_<host>[_<port>]/auth_state_<identity>.json
VICTIM_AUTH_STATE_PATH=
ATTACKER_AUTH_STATE_PATH=

# Optional legacy aliases accepted by the standalone replayer.
# AUTH_STATE_PATH is treated as the victim state; ATTACKER_STATE_PATH as the
# attacker state. Prefer the identity-specific names above.
AUTH_STATE_PATH=
ATTACKER_STATE_PATH=

# ---------------------------------------------------------------------------
# Identity preflight
# ---------------------------------------------------------------------------

# Optional exact identity endpoint. Leave empty to try IDENTITY_URLS.
IDENTITY_URL=

# Comma-separated relative or absolute endpoints returning the current user.
# The replayer compares victim and attacker responses to prove distinct users.
IDENTITY_URLS=/me,/api/me,/user,/api/user,/profile,/me.php,/api/me.php

# Legacy alias for IDENTITY_URL, accepted for compatibility.
PREFLIGHT_URL=

# ---------------------------------------------------------------------------
# Crawler
# ---------------------------------------------------------------------------

MAX_PAGES=500
MAX_DEPTH=5
DELAY_SECONDS=0.5

# Set true only for a public/unauthenticated crawl. A full credential-swap
# replay still requires distinct victim and attacker states.
NO_LOGIN=false

# Wait for rendered-page network activity to settle.
NETWORK_SETTLE_MS=1500
NETWORK_IDLE_TIMEOUT_MS=3000

# Reload pages after network listeners are attached.
RELOAD_AFTER_LISTENERS=false

# Optional JSON object mapping page paths to explicitly authorized scripts.
# Example:
# CRAWLER_PAGE_SCRIPTS={"\/vulnerabilities\/api\/":["fetch('\/api\/users')"]}
CRAWLER_PAGE_SCRIPTS=

# ---------------------------------------------------------------------------
# Proxy and network capture
# ---------------------------------------------------------------------------

# Standalone proxy listener port.
PROXY_PORT=8080

# Optional proxy host. Leave empty to use the local/default host.
PROXY_HOST=

# Whether the crawler starts its managed proxy automatically.
START_PROXY=false
MANAGED_PROXY_PORT=8081

# Capture API-like paths with these comma-separated prefixes.
API_PREFIXES=/api,/ajax,/graphql,/rest,/rpc,/service,/services

# Request/response body capture is disabled by default because bodies may
# contain sensitive data. Enable only in an authorized test environment.
CAPTURE_BODIES=false
MAX_BODY_BYTES=65536

# Number of captured events between durable output checkpoints.
CAPTURE_CHECKPOINT_INTERVAL=25

# Optional explicit output paths for standalone capture/logger use.
CAPTURE_OUT=
CAPTURE_ERROR_OUT=

# ---------------------------------------------------------------------------
# Reporting and reproducibility
# ---------------------------------------------------------------------------

# Optional fixed timestamp for deterministic report output and tests.
# Leave empty during normal testing.
PHASE2_FIXED_TIMESTAMP=
